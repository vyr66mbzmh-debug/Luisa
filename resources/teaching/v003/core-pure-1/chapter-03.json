e tracked separately","sourceSlide":5}},{"id":"core-pure-1-c03-full-s006","chapter":3,"sourceSlide":6,"title":"Further Examples of Sums of Natural Numbers","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":1520,"h":57},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"Use the formula \\(\\sum_{r=1}^n r=\\tfrac12n(n+1)\\) to evaluate these textbook examples.","fontSize":32,"hangingIndent":0,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":40,"y":112,"w":748,"h":56},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\(\\sum_{r=1}^4(2r-1)\\)","fontSize":32,"hangingIndent":0,"color":"#151515"}},{"id":"native-3","kind":"sp","box":{"x":54,"y":190,"w":720,"h":107},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[=1+3+5+7=16.\\]There are few enough terms to list them.","fontSize":32,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-3"},{"id":"answer-native-3","kind":"sp","box":{"x":40,"y":176,"w":748,"h":135},"cover":true,"coverLabel":"1","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-4","kind":"sp","box":{"x":40,"y":319,"w":748,"h":56},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\(\\sum_{r=1}^{50}r\\)","fontSize":32,"hangingIndent":0,"color":"#151515"}},{"id":"native-5","kind":"sp","box":{"x":54,"y":397,"w":720,"h":66},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[=\\tfrac12\\times50\\times51=1275.\\]","fontSize":32,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-5"},{"id":"answer-native-5","kind":"sp","box":{"x":40,"y":383,"w":748,"h":94},"cover":true,"coverLabel":"2","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-6","kind":"sp","box":{"x":812,"y":112,"w":748,"h":56},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\(\\sum_{r=25}^{50}r\\)","fontSize":32,"hangingIndent":0,"color":"#151515"}},{"id":"native-7","kind":"sp","box":{"x":826,"y":190,"w":720,"h":222},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[=\\sum_{r=1}^{50}r-\\sum_{r=1}^{24}r\\]\\[=1275-\\left(\\tfrac12\\times24\\times25\\right)\\]\\[=975.\\]","fontSize":32,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-7"},{"id":"answer-native-7","kind":"sp","box":{"x":812,"y":176,"w":748,"h":250},"cover":true,"coverLabel":"3","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-8","kind":"sp","box":{"x":40,"y":497,"w":748,"h":142},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"Show \\(\\sum_{r=5}^{2N-1}r=2N^2-N-10\\), for \\(N\\geq3\\).\\par Tip: subtract the sum up to one less than the lower limit. Substitute the upper limit, here \\(2N-1\\), for \\(n\\).","fontSize":32,"hangingIndent":0,"color":"#151515"}},{"id":"native-9","kind":"sp","box":{"x":826,"y":511,"w":720,"h":225},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\sum_{r=5}^{2N-1}r=\\sum_{r=1}^{2N-1}r-\\sum_{r=1}^4r\\]\\[=\\tfrac12(2N-1)(2N)-\\tfrac12(4)(5)\\]\\[=2N^2-N-10.\\]","fontSize":32,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-9"},{"id":"answer-native-9","kind":"sp","box":{"x":812,"y":497,"w":748,"h":253},"cover":true,"coverLabel":"4","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"core-pure-1-c03-full","courseId":"core-pure-1","variant":"full","covers":["answer-native-3","answer-native-5","answer-native-7","answer-native-9"],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":["answer-native-3","answer-native-5","answer-native-7","answer-native-9"],"nextActionOrder":["answer-native-3","answer-native-5","answer-native-7","answer-native-9"],"afterAnswerActions":{},"source