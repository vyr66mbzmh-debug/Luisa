:"native-1","kind":"sp","box":{"x":40,"y":35,"w":1520,"h":50},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"Exercise 3A — Core Pure Book 1, pages 46–47.","fontSize":32,"hangingIndent":0,"color":"#151515"}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"core-pure-1-c03-full","courseId":"core-pure-1","variant":"full","covers":[],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":[],"nextActionOrder":[],"afterAnswerActions":{},"sourceMapping":{"method":"Native text and LaTeX conversion; acceptance tracked separately","sourceSlide":14}},{"id":"core-pure-1-c03-full-s015","chapter":3,"sourceSlide":15,"title":"Sums of Squares and Cubes","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":748,"h":148},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"(a) Show \\(\\sum_{r=n+1}^{2n}r^2=\\tfrac16n(2n+1)(7n+1)\\).\\par (b) Verify for \\(n=1\\) and \\(n=2\\).\\par Tip: factor out common terms before expanding.","fontSize":32,"hangingIndent":0,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":812,"y":35,"w":748,"h":308},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\sum_{r=1}^n r^2=\\tfrac16n(n+1)(2n+1)\\]\\[\\sum_{r=1}^n r^3=\\tfrac14n^2(n+1)^2.\\]The polynomial degree of each sum is one higher than that of its terms: squares give a cubic, cubes a quartic.","fontSize":32,"hangingIndent":0,"color":"#151515"}},{"id":"native-3","kind":"sp","box":{"x":54,"y":377,"w":720,"h":326},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\sum_{r=n+1}^{2n}r^2=\\sum_{r=1}^{2n}r^2-\\sum_{r=1}^n r^2\\]\\[=\\tfrac16(2n)(2n+1)(4n+1)\\]\\[{}-\\tfrac16n(n+1)(2n+1)\\]\\[=\\tfrac16n(2n+1)\\bigl(2(4n+1)-(n+1)\\bigr)\\]\\[=\\tfrac16n(2n+1)(7n+1).\\]","fontSize":32,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-3"},{"id":"answer-native-3","kind":"sp","box":{"x":40,"y":363,"w":748,"h":354},"cover":true,"coverLabel":"a","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-4","kind":"sp","box":{"x":826,"y":377,"w":720,"h":307},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"When \\(n=1\\):\\[2^2=\\tfrac16\\times3\\times8\\]\\[4=4.\\]When \\(n=2\\):\\[3^2+4^2=\\tfrac26\\times5\\times15\\]\\[25=25.\\]","fontSize":32,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-4"},{"id":"answer-native-4","kind":"sp","box":{"x":812,"y":363,"w":748,"h":335},"cover":true,"coverLabel":"b","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"core-pure-1-c03-full","courseId":"core-pure-1","variant":"full","covers":["answer-native-3","answer-native-4"],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":["answer-native-3","answer-native-4"],"nextActionOrder":["answer-native-3","answer-native-4"],"afterAnswerActions":{},"sourceMapping":{"method":"Native text and LaTeX conversion; acceptance tracked separately","sourceSlide":15}},{"id":"core-pure-1-c03-full-s016","chapter":3,"sourceSlide":16,"title":"Test Your Understanding","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":490.6666666666667,"h":609},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"Edexcel FP1 (Old), June 2013, Q5\\par (a) Use standard sums of \\(r\\) and \\(r^2\\) to show\\[\\sum_{r=1}^n(r+2)(r+3)\\]\\[=\\tfrac13n(n^2+9n+26)\\]for positive integers \\(n\\). (6 marks)\\par (b) Hence show\\[\\sum_{r=n+1}^{3n}(r+2)(r+3)\\]\\[=\\tfrac23n(an^2+bn+c),\\]finding integers \\(a,b,c\\). (4 marks)","fontSize":32,"hangingIndent":0,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":568.6666666666667,"y":49,"w":462.6666666666667,"h":522},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\sum_{r=1}^n(r+2)(r+3)\\]\\[=\\sum_{r=1}^n r^2+5\\sum_{r=1}^n r+6\\sum_{r=1}^n1\\]\\[=\\tfrac16n(n+1)(2n+1)\\]\\[{}+\\tfrac52n(n+1)+6n\\]\\[=\\tfrac16n\\bigl((n+1)(2n+1)\\]\\[{}+15(n+1)+36\\bigr)\\]\\[=\\tfrac16n(2n^2+18n+52)\\]\\[=\\tfrac13n(n^2+9n+26).\\]","fontSize":32,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-2"},{"id":"answer-native-2","kind":"sp","box":{"x":554.6666666666667,"y":35,"w":490.6666666666667,"h":550},"cover":true,"coverLabel":"a","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-3","kind":"sp","box":{"x":1083.3333333333335,"y":49,"w":462.6666666666667,"h":576},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\sum_{r=n+1}^{3n}(r+2)(r+3)\\]\\[=\\tfrac13(3n)\\bigl((3n)^2+9(3n)+26\\bigr)\\]\\[{}-\\tfrac13n(n^2+9n+26)\\]\\[=n(9n^2+27n+26)\\]\\[{}-\\tfrac13n(n^2+9n+26)\\]\\[=\\tfrac13n(27n^2+81n+78\\]\\[{}-n^2-9n-26)\\]\\[=\\tfrac13n(26n^2+72n+52)\\]\\[=\\tfrac23n(13n^2+36n+26).\\]\\[a=13,\\ b=36,\\ c=26.\\]","fontSize":32,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-3"},{"id":"answer-native-3","kind":"sp","box":{"x":1069.3333333333335,"y":35,"w":490.6666666666667,"h":604},"cover":true,"coverLabel":"b","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"core-pure-1-c03-full","courseId":"core-pure-1","variant":"full","covers":["answer-native-2","answer-native-3"],"headerShapes":[],"titlePageCandidate":false,"titlePage":false,"extension":false,"reviewStatus":"source-extracted-not-approved","contentWidth":1600,"contentHeight":850,"measuredLayout":true,"answerOrder":["answer-native-2","answer-native-3"],"nextActionOrder":["answer-native-2","answer-native-3"],"afterAnswerActions":{},"sourceMapping":{"method":"Native text and LaTeX conversion; acceptance tracked separately","sourceSlide":16}},{"id":"core-pure-1-c03-full-s017","chapter":3,"sourceSlide":17,"title":"Harder Exam Question","shapes":[{"id":"native-1","kind":"sp","box":{"x":40,"y":35,"w":1520,"h":310},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"Edexcel FP1 (Old), January 2011, Q5\\par (a) Use the sums of \\(r,r^2,r^3\\) to prove\\[\\sum_{r=1}^n r(r+1)(r+5)=\\tfrac14n(n+1)(n+2)(n+7)\\]for all positive integers \\(n\\). (5 marks)\\par (b) Hence, or otherwise, find \\(\\sum_{r=20}^{50}r(r+1)(r+5)\\). (2 marks)","fontSize":32,"hangingIndent":0,"color":"#151515"}},{"id":"native-2","kind":"sp","box":{"x":54,"y":379,"w":720,"h":469},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"\\[\\sum_{r=1}^n(r^3+6r^2+5r)\\]\\[=\\tfrac14n^2(n+1)^2+6\\times\\tfrac16n(n+1)(2n+1)\\]\\[{}+5\\times\\tfrac12n(n+1)\\]\\[=\\tfrac14n^2(n+1)^2+n(n+1)(2n+1)+\\tfrac52n(n+1)\\]\\[=\\tfrac14n(n+1)\\bigl(n(n+1)+4(2n+1)+10\\bigr)\\]\\[=\\tfrac14n(n+1)(n^2+n+8n+4+10)\\]\\[=\\tfrac14n(n+1)(n^2+9n+14)\\]\\[=\\tfrac14n(n+1)(n+2)(n+7).\\]","fontSize":32,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-2"},{"id":"answer-native-2","kind":"sp","box":{"x":40,"y":365,"w":748,"h":497},"cover":true,"coverLabel":"a","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}},{"id":"native-3","kind":"sp","box":{"x":826,"y":379,"w":720,"h":362},"fill":"transparent","line":{"color":"transparent"},"transcription":{"tex":"Let \\(S_m=\\sum_{r=1}^m r(r+1)(r+5)\\). Then\\[\\sum_{r=20}^{50}r(r+1)(r+5)=S_{50}-S_{19}\\]\\[=\\tfrac14(50)(51)(52)(57)\\]\\[{}-\\tfrac14(19)(20)(21)(26)\\]\\[=1889550-51870\\]\\[=1837680.\\]","fontSize":32,"hangingIndent":0,"color":"#1760a6"},"answerFor":"answer-native-3"},{"id":"answer-native-3","kind":"sp","box":{"x":812,"y":365,"w":748,"h":390},"cover":true,"coverLabel":"b","fill":"#d6e5f5","line":{"color":"#6383a4","width":1.5}}],"animation":{"steps":[],"triggers":{},"initialHidden":[]},"deckId":"core-pure-1-c03-full",